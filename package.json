{
  "type": "module",
  "name": "ai-security-triage",
  "version": "1.0.0",
  "description": "AI-assisted triage of AWS security logs, built with TypeScript, Python, Terraform, and AWS.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:db:pg": "vitest run tests/integration --no-file-parallelism",
    "test:db:data-api": "vitest run tests/integration --no-file-parallelism --mode data-api",
    "build": "tsc",
    "ingest": "tsc && node --env-file=.env dist/ingest/run.js",
    "db:check": "tsc && node --env-file=.env dist/db/check.js",
    "api": "tsc && node --env-file=.env dist/api/server.js",
    "token": "tsc && node --env-file=.env dist/auth/make-token.js",
    "db:migrate:aws": "tsc && node --env-file=.env dist/db/migrate-aws.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TmoodGitHub/ai-security-triage.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TmoodGitHub/ai-security-triage/issues"
  },
  "homepage": "https://github.com/TmoodGitHub/ai-security-triage#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1157.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  }
}
